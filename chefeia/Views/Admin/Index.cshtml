@model chefeia.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Administração";
}

<style>

    body {
        background: #f5f1eb;
    }

    .admin-wrapper {
        max-width: 1250px;
        margin: 35px auto 80px;
        padding: 0 20px;
    }

    .admin-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .admin-title h1 {
        margin: 0;
        font-size: 34px;
        color: #2b170d;
    }

    .admin-title p {
        margin: 7px 0 0;
        color: #75665c;
    }

    .admin-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .admin-button {
        text-decoration: none;
        padding: 11px 16px;
        border-radius: 10px;
        font-weight: 700;
        background: #2b170d;
        color: white;
    }

    .admin-button.orange {
        background: #f5661b;
    }

    .admin-grid {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .admin-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow:
            0 10px 35px rgba(50,30,17,.06);
        border: 1px solid #eadfd4;
    }

    .admin-card-icon {
        font-size: 33px;
        margin-bottom: 14px;
    }

    .admin-card-label {
        color: #786a60;
        font-size: 13px;
        font-weight: 700;
    }

    .admin-card-value {
        margin-top: 6px;
        font-size: 34px;
        font-weight: 900;
        color: #2b170d;
    }

    .admin-card-value small {
        font-size: 13px;
        color: #786a60;
        font-weight: 500;
    }

    .admin-section {
        background: white;
        border: 1px solid #eadfd4;
        border-radius: 22px;
        padding: 28px;
        margin-bottom: 25px;
        box-shadow:
            0 10px 35px rgba(50,30,17,.05);
    }

    .admin-section h2 {
        margin-top: 0;
        color: #2b170d;
    }

    .preview-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }

    .preview-card {
        overflow: hidden;
        border-radius: 17px;
        background: #faf6f1;
        border: 1px solid #eadfd4;
    }

    .preview-card img {
        width: 100%;
        height: 210px;
        object-fit: cover;
    }

    .preview-card-body {
        padding: 18px;
    }

    .preview-card-body h3 {
        margin: 0 0 7px;
        color: #2b170d;
    }

    .preview-card-body p {
        margin: 0;
        color: #786a60;
    }

    .menu-grid {
        display: grid;
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
        gap: 15px;
    }

    .menu-card {
        display: block;
        text-decoration: none;
        background: #fffaf3;
        border: 1px solid #eadfd4;
        border-radius: 16px;
        padding: 22px;
        color: #2b170d;
        transition: .2s;
    }

    .menu-card:hover {
        transform: translateY(-3px);
        box-shadow:
            0 12px 30px rgba(50,30,17,.08);
        color: #2b170d;
    }

    .menu-card span {
        font-size: 30px;
    }

    .menu-card strong {
        display: block;
        margin-top: 12px;
        font-size: 16px;
    }

    .menu-card small {
        display: block;
        margin-top: 5px;
        color: #786a60;
    }

    @@media(max-width: 900px) {

        .admin-grid {
            grid-template-columns: 1fr;
        }

        .preview-grid {
            grid-template-columns: 1fr;
        }

        .menu-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media(max-width: 600px) {

        .admin-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .menu-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="admin-wrapper">

    <div class="admin-top">

        <div class="admin-title">

            <h1>
                👨‍🍳 Administração
            </h1>

            <p>
                Controle o @Model.SiteName
            </p>

        </div>


        <div class="admin-actions">

            <a
                href="/"
                class="admin-button">

                🌎 Ver site

            </a>

            <a
                asp-controller="Admin"
                asp-action="Configuracoes"
                class="admin-button orange">

                ⚙️ Configurações

            </a>

        </div>

    </div>


    <div class="admin-grid">

        <article class="admin-card">

            <div class="admin-card-icon">
                🌿
            </div>

            <div class="admin-card-label">
                Plano Gratuito
            </div>

            <div class="admin-card-value">

                @Model.FreeMonthlyLimit

                <small>
                    consultas/mês
                </small>

            </div>

        </article>


        <article class="admin-card">

            <div class="admin-card-icon">
                👑
            </div>

            <div class="admin-card-label">
                Plano Premium
            </div>

            <div class="admin-card-value">

                @Model.PremiumMonthlyLimit

                <small>
                    consultas/mês
                </small>

            </div>

        </article>


        <article class="admin-card">

            <div class="admin-card-icon">
                💰
            </div>

            <div class="admin-card-label">
                Preço Premium
            </div>

            <div class="admin-card-value">

                R$ @Model.PremiumPrice.ToString("N2")

                <small>
                    / mês
                </small>

            </div>

        </article>

    </div>


    <section class="admin-section">

        <h2>
            🧭 Painel
        </h2>


        <div class="menu-grid">

            <a
                asp-controller="Admin"
                asp-action="Configuracoes"
                class="menu-card">

                <span>
                    🖼️
                </span>

                <strong>
                    Página inicial
                </strong>

                <small>
                    Imagens, títulos e textos
                </small>

            </a>


            <a
                asp-controller="Admin"
                asp-action="Planos"
                class="menu-card">

                <span>
                    👑
                </span>

                <strong>
                    Planos
                </strong>

                <small>
                    Limites e preço Premium
                </small>

            </a>


            <a
                asp-controller="Admin"
                asp-action="Usuarios"
                class="menu-card">

                <span>
                    👥
                </span>

                <strong>
                    Usuários
                </strong>

                <small>
                    Gratuitos e Premium
                </small>

            </a>


            <a
                asp-controller="Admin"
                asp-action="Consumo"
                class="menu-card">

                <span>
                    📊
                </span>

                <strong>
                    Consumo IA
                </strong>

                <small>
                    Consultas e utilização
                </small>

            </a>

        </div>

    </section>


    <section class="admin-section">

        <h2>
            👀 Prévia da página inicial
        </h2>


        <div class="preview-grid">

            <article class="preview-card">

                <img
                    src="@Model.HeroImageUrl"
                    alt="Imagem principal" />

                <div class="preview-card-body">

                    <h3>
                        Banner principal
                    </h3>

                    <p>
                        @Model.HeroTitle
                    </p>

                </div>

            </article>


            <article class="preview-card">

                <img
                    src="@Model.FeaturedRecipeImageUrl"
                    alt="Receita em destaque" />

                <div class="preview-card-body">

                    <h3>
                        Receita em destaque
                    </h3>

                    <p>
                        @Model.FeaturedRecipeTitle
                    </p>

                </div>

            </article>

        </div>

    </section>

</div>