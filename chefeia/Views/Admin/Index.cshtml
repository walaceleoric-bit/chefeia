@model chefeia.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Administração";
}

<style>

    body {
        background: #f5f1eb;
    }

    .admin-wrapper {
        max-width: 1250px;
        margin: 35px auto 80px;
        padding: 0 20px;
    }

    /* =====================================================
           TOPO
        ===================================================== */

    .admin-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .admin-title h1 {
        margin: 0;
        font-size: 34px;
        color: #2b170d;
    }

    .admin-title p {
        margin: 7px 0 0;
        color: #75665c;
    }

    .admin-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .admin-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        padding: 11px 16px;
        border-radius: 10px;
        font-weight: 700;
        background: #2b170d;
        color: white;
        transition: transform .2s, box-shadow .2s, background .2s;
    }

        .admin-button:hover {
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 7px 20px rgba(43,23,13,.15);
        }

        .admin-button.orange {
            background: #f5661b;
        }

            .admin-button.orange:hover {
                background: #df5713;
            }


    /* =====================================================
           CARDS DOS PLANOS
        ===================================================== */

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .admin-card {
        position: relative;
        overflow: hidden;
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 10px 35px rgba(50,30,17,.06);
        border: 1px solid #eadfd4;
    }

        .admin-card::after {
            content: "";
            position: absolute;
            right: -30px;
            top: -30px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(245,102,27,.05);
        }

    .admin-card-icon {
        position: relative;
        z-index: 1;
        font-size: 33px;
        margin-bottom: 14px;
    }

    .admin-card-label {
        position: relative;
        z-index: 1;
        color: #786a60;
        font-size: 13px;
        font-weight: 700;
    }

    .admin-card-value {
        position: relative;
        z-index: 1;
        margin-top: 6px;
        font-size: 34px;
        font-weight: 900;
        color: #2b170d;
    }

        .admin-card-value small {
            font-size: 13px;
            color: #786a60;
            font-weight: 500;
        }


    /* =====================================================
           SEÇÕES
        ===================================================== */

    .admin-section {
        background: white;
        border: 1px solid #eadfd4;
        border-radius: 22px;
        padding: 28px;
        margin-bottom: 25px;
        box-shadow: 0 10px 35px rgba(50,30,17,.05);
    }

    .admin-section-header {
        margin-bottom: 22px;
    }

        .admin-section-header h2 {
            margin: 0;
            color: #2b170d;
            font-size: 22px;
        }

        .admin-section-header p {
            margin: 6px 0 0;
            color: #786a60;
            font-size: 13px;
        }


    /* =====================================================
           MENU ADMINISTRATIVO
        ===================================================== */

    .menu-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
    }

    .menu-card {
        display: flex;
        flex-direction: column;
        min-height: 150px;
        text-decoration: none;
        background: linear-gradient( 145deg, #fffaf3, #ffffff );
        border: 1px solid #eadfd4;
        border-radius: 16px;
        padding: 22px;
        color: #2b170d;
        transition: transform .2s, box-shadow .2s, border-color .2s;
    }

        .menu-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(50,30,17,.08);
            border-color: #e8c9b4;
            color: #2b170d;
        }

        .menu-card span {
            font-size: 30px;
        }

        .menu-card strong {
            display: block;
            margin-top: 12px;
            font-size: 16px;
        }

        .menu-card small {
            display: block;
            margin-top: 5px;
            color: #786a60;
            line-height: 1.45;
        }


    /* =====================================================
           RESUMO DA PÁGINA INICIAL
        ===================================================== */

    .home-summary {
        display: flex;
        align-items: center;
        gap: 22px;
        padding: 25px;
        border-radius: 18px;
        background: linear-gradient( 135deg, #fff7ed, #fffdf9 );
        border: 1px solid #f0dfcf;
    }

    .home-summary-icon {
        flex-shrink: 0;
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #f5661b;
        color: white;
        font-size: 32px;
        box-shadow: 0 10px 25px rgba(245,102,27,.18);
    }

    .home-summary-content {
        flex: 1;
    }

    .home-summary-label {
        display: block;
        margin-bottom: 5px;
        color: #d65a18;
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .7px;
    }

    .home-summary-content h3 {
        margin: 0;
        color: #2b170d;
        font-family: Georgia, serif;
        font-size: 24px;
    }

    .home-summary-content p {
        margin: 7px 0 0;
        color: #786a60;
        font-size: 13px;
        line-height: 1.55;
    }

    .home-summary-action {
        flex-shrink: 0;
    }

        .home-summary-action a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 11px 16px;
            border-radius: 10px;
            background: white;
            border: 1px solid #e4d4c6;
            color: #2b170d;
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
            transition: transform .2s, box-shadow .2s;
        }

            .home-summary-action a:hover {
                color: #2b170d;
                transform: translateY(-1px);
                box-shadow: 0 7px 20px rgba(50,30,17,.08);
            }


    /* =====================================================
           RESPONSIVO
        ===================================================== */

    @@media(max-width: 900px) {

        .admin-grid {
            grid-template-columns: 1fr;
        }

        .menu-grid {
            grid-template-columns: 1fr 1fr;
        }

        .home-summary {
            align-items: flex-start;
        }
    }


    @@media(max-width: 700px) {

        .admin-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .home-summary {
            flex-direction: column;
        }

        .home-summary-action {
            width: 100%;
        }

            .home-summary-action a {
                width: 100%;
            }
    }


    @@media(max-width: 600px) {

        .admin-wrapper {
            padding: 0 13px;
            margin-top: 25px;
        }

        .admin-title h1 {
            font-size: 29px;
        }

        .admin-actions {
            width: 100%;
        }

        .admin-button {
            flex: 1;
        }

        .menu-grid {
            grid-template-columns: 1fr;
        }

        .admin-section {
            padding: 20px;
        }

        .menu-card {
            min-height: auto;
        }
    }

</style>


<div class="admin-wrapper">


    <!-- =====================================================
         CABEÇALHO
    ====================================================== -->

    <div class="admin-top">

        <div class="admin-title">

            <h1>
                👨‍🍳 Administração
            </h1>

            <p>
                Controle o @Model.SiteName
            </p>

        </div>


        <div class="admin-actions">

            <a href="/"
               class="admin-button">

                🌎 Ver site

            </a>


            <a asp-controller="Admin"
               asp-action="Configuracoes"
               class="admin-button orange">

                ⚙️ Configurações

            </a>

        </div>

    </div>



    <!-- =====================================================
         RESUMO DOS PLANOS
    ====================================================== -->

    <div class="admin-grid">


        <!-- GRATUITO -->

        <article class="admin-card">

            <div class="admin-card-icon">
                🌿
            </div>

            <div class="admin-card-label">
                Plano Gratuito
            </div>

            <div class="admin-card-value">

                @Model.FreeMonthlyLimit

                <small>
                    consultas/mês
                </small>

            </div>

        </article>



        <!-- PREMIUM -->

        <article class="admin-card">

            <div class="admin-card-icon">
                👑
            </div>

            <div class="admin-card-label">
                Plano Premium
            </div>

            <div class="admin-card-value">

                @Model.PremiumMonthlyLimit

                <small>
                    consultas/mês
                </small>

            </div>

        </article>



        <!-- PREÇO -->

        <article class="admin-card">

            <div class="admin-card-icon">
                💰
            </div>

            <div class="admin-card-label">
                Preço Premium
            </div>

            <div class="admin-card-value">

                R$ @Model.PremiumPrice.ToString("N2")

                <small>
                    / mês
                </small>

            </div>

        </article>

    </div>



    <!-- =====================================================
         PAINEL ADMINISTRATIVO
    ====================================================== -->

    <section class="admin-section">

        <div class="admin-section-header">

            <h2>
                🧭 Painel administrativo
            </h2>

            <p>
                Gerencie as principais áreas do sistema.
            </p>

        </div>


        <div class="menu-grid">


            <!-- PÁGINA INICIAL -->

            <a asp-controller="Admin"
               asp-action="Configuracoes"
               class="menu-card">

                <span>
                    🏠
                </span>

                <strong>
                    Página inicial
                </strong>

                <small>
                    Títulos, textos e informações exibidas no site.
                </small>

            </a>



            <!-- PLANOS -->

            <a asp-controller="Admin"
               asp-action="Planos"
               class="menu-card">

                <span>
                    👑
                </span>

                <strong>
                    Planos
                </strong>

                <small>
                    Limites de consultas e valor do Premium.
                </small>

            </a>



            <!-- USUÁRIOS -->

            <a asp-controller="Admin"
               asp-action="Usuarios"
               class="menu-card">

                <span>
                    👥
                </span>

                <strong>
                    Usuários
                </strong>

                <small>
                    Gerencie usuários gratuitos, Premium e administradores.
                </small>

            </a>



            <!-- CONSUMO IA -->

            <a asp-controller="Admin"
               asp-action="Consumo"
               class="menu-card">

                <span>
                    📊
                </span>

                <strong>
                    Consumo IA
                </strong>

                <small>
                    Acompanhe consultas, utilização e funcionamento da IA.
                </small>

            </a>

        </div>

    </section>



    <!-- =====================================================
         PÁGINA INICIAL
    ====================================================== -->

    <section class="admin-section">

        <div class="admin-section-header">

            <h2>
                🏠 Página inicial
            </h2>

            <p>
                Informações principais atualmente configuradas no site.
            </p>

        </div>


        <div class="home-summary">

            <div class="home-summary-icon">
                ✨
            </div>


            <div class="home-summary-content">

                <span class="home-summary-label">
                    Título principal
                </span>

                <h3>
                    @Model.HeroTitle
                </h3>

                <p>
                    Edite o título, subtítulo, campo de busca
                    e os benefícios exibidos na página inicial.
                </p>

            </div>


            <div class="home-summary-action">

                <a asp-controller="Admin"
                   asp-action="Configuracoes">

                    Editar página inicial →

                </a>

            </div>

        </div>

    </section>

</div>