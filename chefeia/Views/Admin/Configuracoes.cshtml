@model chefeia.Models.SiteSettings

@{
    ViewData["Title"] = "Configurações";
}

<style>

    body {
        background: #f7f3ed;
    }

    .admin-page {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px 80px;
    }

    /* =====================================================
           CABEÇALHO
        ===================================================== */

    .admin-header {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, #2c1a10, #432719 );
        color: white;
        padding: 32px;
        border-radius: 22px;
        margin-bottom: 25px;
        box-shadow: 0 12px 35px rgba(44,26,16,.12);
    }

        .admin-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -60px;
            top: -80px;
            border-radius: 50%;
            background: rgba(245,102,27,.12);
        }

        .admin-header h1 {
            position: relative;
            z-index: 1;
            margin: 0 0 8px;
            font-size: 32px;
        }

        .admin-header p {
            position: relative;
            z-index: 1;
            margin: 0;
            opacity: .78;
        }


    /* =====================================================
           VOLTAR
        ===================================================== */

    .admin-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 18px;
        color: #6f5d51;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
    }

        .admin-back:hover {
            color: #f5661b;
        }


    /* =====================================================
           SUCESSO
        ===================================================== */

    .admin-success {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #e9f8ec;
        color: #237a39;
        padding: 15px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        border: 1px solid #cce8d2;
        font-weight: 700;
    }


    /* =====================================================
           VALIDAÇÃO
        ===================================================== */

    .validation-summary-errors {
        padding: 15px 20px;
        margin-bottom: 20px;
        border-radius: 12px;
        background: #fff0ee;
        border: 1px solid #f1d0cc;
        color: #a6382e;
    }

    .field-validation-error {
        color: #b43a30;
        font-size: 12px;
    }


    /* =====================================================
           CARDS
        ===================================================== */

    .admin-card {
        background: white;
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 22px;
        border: 1px solid #eadfd4;
        box-shadow: 0 10px 35px rgba(0,0,0,.05);
    }

    .admin-card-header {
        margin-bottom: 23px;
        padding-bottom: 17px;
        border-bottom: 1px solid #eee5dd;
    }

        .admin-card-header h2 {
            margin: 0;
            color: #2c1a10;
            font-size: 21px;
        }

        .admin-card-header p {
            margin: 6px 0 0;
            color: #84746a;
            font-size: 13px;
            line-height: 1.5;
        }


    /* =====================================================
           FORMULÁRIO
        ===================================================== */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-weight: 800;
            color: #4c382c;
            font-size: 13px;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #ddd4cc;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 15px;
            color: #2c1a10;
            background: white;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

            .form-group input:focus,
            .form-group textarea:focus {
                border-color: #f5661b;
                box-shadow: 0 0 0 3px rgba(245,102,27,.10);
            }

        .form-group textarea {
            min-height: 95px;
            resize: vertical;
        }

    .form-help {
        color: #96877d;
        font-size: 11px;
        line-height: 1.4;
    }


    /* =====================================================
           CARDS DE BENEFÍCIOS
        ===================================================== */

    .features-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .feature-editor {
        padding: 20px;
        border-radius: 16px;
        border: 1px solid #eadfd4;
        background: linear-gradient( 145deg, #fffaf5, #ffffff );
    }

    .feature-editor-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 17px;
        color: #2c1a10;
        font-size: 14px;
        font-weight: 900;
    }

    .feature-editor-number {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f5661b;
        color: white;
        font-size: 12px;
    }

    .feature-editor .form-grid {
        gap: 14px;
    }


    /* =====================================================
           AVISO DOS PLANOS
        ===================================================== */

    .plans-notice {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 19px;
        border-radius: 15px;
        border: 1px solid #f0d8c5;
        background: linear-gradient( 135deg, #fff6eb, #fffdf9 );
    }

    .plans-notice-icon {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #fff0e2;
        font-size: 23px;
    }

    .plans-notice strong {
        display: block;
        color: #2c1a10;
        font-size: 14px;
    }

    .plans-notice p {
        margin: 4px 0 0;
        color: #786a60;
        font-size: 12px;
        line-height: 1.5;
    }

    .plans-notice a {
        flex-shrink: 0;
        margin-left: auto;
        padding: 10px 14px;
        border-radius: 9px;
        background: #2c1a10;
        color: white;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;
    }

        .plans-notice a:hover {
            color: white;
            background: #442719;
        }


    /* =====================================================
           BOTÃO SALVAR
        ===================================================== */

    .admin-save {
        position: sticky;
        bottom: 20px;
        z-index: 20;
        background: rgba(44,26,16,.96);
        padding: 15px;
        border-radius: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        box-shadow: 0 12px 30px rgba(0,0,0,.18);
        backdrop-filter: blur(8px);
    }

        .admin-save span {
            color: rgba(255,255,255,.72);
            font-size: 12px;
        }

        .admin-save button {
            border: 0;
            background: #ff681f;
            color: white;
            padding: 14px 28px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 800;
            cursor: pointer;
            transition: transform .2s, background .2s;
        }

            .admin-save button:hover {
                background: #e95915;
                transform: translateY(-1px);
            }


    /* =====================================================
           RESPONSIVO
        ===================================================== */

    @@media(max-width: 760px) {

        .form-grid,
        .features-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: auto;
        }

        .plans-notice {
            align-items: flex-start;
            flex-wrap: wrap;
        }

            .plans-notice a {
                width: 100%;
                margin-left: 0;
                text-align: center;
            }

        .admin-save {
            align-items: stretch;
            flex-direction: column;
        }

            .admin-save span {
                text-align: center;
            }

            .admin-save button {
                width: 100%;
            }
    }


    @@media(max-width: 500px) {

        .admin-page {
            padding-left: 12px;
            padding-right: 12px;
        }

        .admin-header {
            padding: 25px 20px;
        }

            .admin-header h1 {
                font-size: 27px;
            }

        .admin-card {
            padding: 20px;
        }
    }

</style>


<div class="admin-page">


    <!-- =====================================================
         VOLTAR
    ====================================================== -->

    <a asp-controller="Admin"
       asp-action="Index"
       class="admin-back">

        ← Voltar para administração

    </a>


    <!-- =====================================================
         CABEÇALHO
    ====================================================== -->

    <div class="admin-header">

        <h1>
            ⚙️ Configurações do Chefe IA
        </h1>

        <p>
            Personalize os textos e benefícios exibidos
            na página inicial.
        </p>

    </div>


    <!-- =====================================================
         SUCESSO
    ====================================================== -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="admin-success">

            ✅ @TempData["Sucesso"]

        </div>
    }


    <!-- =====================================================
         FORMULÁRIO
    ====================================================== -->

    <form asp-controller="Admin"
          asp-action="Configuracoes"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"></div>


        <!-- =================================================
             CAMPOS MANTIDOS OCULTOS PARA COMPATIBILIDADE
             COM AS CONFIGURAÇÕES JÁ EXISTENTES NO BANCO
        ================================================== -->

        <input asp-for="Id"
               type="hidden" />

        <input asp-for="HeroImageUrl"
               type="hidden" />

        <input asp-for="FreeMonthlyLimit"
               type="hidden" />

        <input asp-for="PremiumMonthlyLimit"
               type="hidden" />

        <input asp-for="PremiumPrice"
               type="hidden" />

        <input asp-for="FeaturedRecipeTitle"
               type="hidden" />

        <input asp-for="FeaturedRecipeImageUrl"
               type="hidden" />

        <input asp-for="FeaturedRecipeCountry"
               type="hidden" />

        <input asp-for="FeaturedRecipeMinutes"
               type="hidden" />

        <input asp-for="FeaturedRecipeServings"
               type="hidden" />


        <!-- =================================================
             IDENTIDADE
        ================================================== -->

        <div class="admin-card">

            <div class="admin-card-header">

                <h2>
                    🏠 Identidade
                </h2>

                <p>
                    Informações principais utilizadas
                    para identificar o sistema.
                </p>

            </div>


            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="SiteName">
                        Nome do sistema
                    </label>

                    <input asp-for="SiteName"
                           autocomplete="off" />

                    <span asp-validation-for="SiteName">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="SiteSlogan">
                        Slogan
                    </label>

                    <input asp-for="SiteSlogan"
                           autocomplete="off" />

                    <span asp-validation-for="SiteSlogan">
                    </span>

                </div>

            </div>

        </div>



        <!-- =================================================
             CONTEÚDO PRINCIPAL
        ================================================== -->

        <div class="admin-card">

            <div class="admin-card-header">

                <h2>
                    ✨ Conteúdo principal
                </h2>

                <p>
                    Textos exibidos na área principal
                    da página inicial.
                </p>

            </div>


            <div class="form-grid">

                <div class="form-group full">

                    <label asp-for="HeroTitle">
                        Título principal
                    </label>

                    <input asp-for="HeroTitle"
                           autocomplete="off" />

                    <span asp-validation-for="HeroTitle">
                    </span>

                </div>


                <div class="form-group full">

                    <label asp-for="HeroSubtitle">
                        Texto principal
                    </label>

                    <textarea asp-for="HeroSubtitle">
                    </textarea>

                    <span asp-validation-for="HeroSubtitle">
                    </span>

                </div>


                <div class="form-group full">

                    <label asp-for="SearchPlaceholder">
                        Texto do campo de ingredientes
                    </label>

                    <input asp-for="SearchPlaceholder"
                           autocomplete="off" />

                    <span class="form-help">
                        Exemplo: frango, batata, tomate...
                    </span>

                    <span asp-validation-for="SearchPlaceholder">
                    </span>

                </div>

            </div>

        </div>



        <!-- =================================================
             BENEFÍCIOS
        ================================================== -->

        <div class="admin-card">

            <div class="admin-card-header">

                <h2>
                    🎴 Benefícios da página inicial
                </h2>

                <p>
                    Edite os quatro benefícios apresentados
                    aos usuários na página principal.
                </p>

            </div>


            <div class="features-grid">


                <!-- BENEFÍCIO 1 -->

                <div class="feature-editor">

                    <div class="feature-editor-title">

                        <span class="feature-editor-number">
                            1
                        </span>

                        Primeiro benefício

                    </div>


                    <div class="form-grid">

                        <div class="form-group">

                            <label asp-for="Feature1Emoji">
                                Emoji
                            </label>

                            <input asp-for="Feature1Emoji"
                                   autocomplete="off" />

                        </div>


                        <div class="form-group">

                            <label asp-for="Feature1Title">
                                Título
                            </label>

                            <input asp-for="Feature1Title"
                                   autocomplete="off" />

                        </div>


                        <div class="form-group full">

                            <label asp-for="Feature1Text">
                                Texto
                            </label>

                            <textarea asp-for="Feature1Text">
                            </textarea>

                        </div>

                    </div>

                </div>



                <!-- BENEFÍCIO 2 -->

                <div class="feature-editor">

                    <div class="feature-editor-title">

                        <span class="feature-editor-number">
                            2
                        </span>

                        Segundo benefício

                    </div>


                    <div class="form-grid">

                        <div class="form-group">

                            <label asp-for="Feature2Emoji">
                                Emoji
                            </label>

                            <input asp-for="Feature2Emoji"
                                   autocomplete="off" />

                        </div>


                        <div class="form-group">

                            <label asp-for="Feature2Title">
                                Título
                            </label>

                            <input asp-for="Feature2Title"
                                   autocomplete="off" />

                        </div>


                        <div class="form-group full">

                            <label asp-for="Feature2Text">
                                Texto
                            </label>

                            <textarea asp-for="Feature2Text">
                            </textarea>

                        </div>

                    </div>

                </div>



                <!-- BENEFÍCIO 3 -->

                <div class="feature-editor">

                    <div class="feature-editor-title">

                        <span class="feature-editor-number">
                            3
                        </span>

                        Terceiro benefício

                    </div>


                    <div class="form-grid">

                        <div class="form-group">

                            <label asp-for="Feature3Emoji">
                                Emoji
                            </label>

                            <input asp-for="Feature3Emoji"
                                   autocomplete="off" />

                        </div>


                        <div class="form-group">

                            <label asp-for="Feature3Title">
                                Título
                            </label>

                            <input asp-for="Feature3Title"
                                   autocomplete="off" />

                        </div>


                        <div class="form-group full">

                            <label asp-for="Feature3Text">
                                Texto
                            </label>

                            <textarea asp-for="Feature3Text">
                            </textarea>

                        </div>

                    </div>

                </div>



                <!-- BENEFÍCIO 4 -->

                <div class="feature-editor">

                    <div class="feature-editor-title">

                        <span class="feature-editor-number">
                            4
                        </span>

                        Quarto benefício

                    </div>


                    <div class="form-grid">

                        <div class="form-group">

                            <label asp-for="Feature4Emoji">
                                Emoji
                            </label>

                            <input asp-for="Feature4Emoji"
                                   autocomplete="off" />

                        </div>


                        <div class="form-group">

                            <label asp-for="Feature4Title">
                                Título
                            </label>

                            <input asp-for="Feature4Title"
                                   autocomplete="off" />

                        </div>


                        <div class="form-group full">

                            <label asp-for="Feature4Text">
                                Texto
                            </label>

                            <textarea asp-for="Feature4Text">
                            </textarea>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- =================================================
             PLANOS
        ================================================== -->

        <div class="admin-card">

            <div class="admin-card-header">

                <h2>
                    👑 Planos
                </h2>

                <p>
                    Os limites e o preço dos planos possuem
                    uma área própria de gerenciamento.
                </p>

            </div>


            <div class="plans-notice">

                <div class="plans-notice-icon">
                    👑
                </div>


                <div>

                    <strong>
                        Gerenciamento dos planos
                    </strong>

                    <p>
                        Altere o limite do plano gratuito,
                        limite Premium, preço e benefícios
                        diretamente na área de Planos.
                    </p>

                </div>


                <a asp-controller="Admin"
                   asp-action="Planos">

                    Gerenciar planos →

                </a>

            </div>

        </div>



        <!-- =================================================
             SALVAR
        ================================================== -->

        <div class="admin-save">

            <span>
                As alterações serão aplicadas à página inicial.
            </span>


            <button type="submit">

                💾 Salvar configurações

            </button>

        </div>

    </form>

</div>