@model List<chefeia.Models.AdminUsuarioViewModel>

@using System.Security.Claims

@{
    ViewData["Title"] = "Usuários";

    var totalUsuarios = Model.Count;

    var totalFree =
        Model.Count(
            x => x.PlanCode == "FREE"
        );

    var totalPremium =
        Model.Count(
            x => x.PlanCode == "PREMIUM"
        );

    var usuarioAtualId =
        User.FindFirstValue(
            ClaimTypes.NameIdentifier
        );
}

<style>

    body {
        background: #f5f1eb;
    }

    .users-admin {
        max-width: 1250px;
        margin: 35px auto 80px;
        padding: 0 20px;
    }

    .users-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

        .users-header h1 {
            margin: 0;
            color: #2b170d;
            font-size: 34px;
        }

        .users-header p {
            margin: 7px 0 0;
            color: #786a60;
        }

    .back-button {
        text-decoration: none;
        background: #2b170d;
        color: white;
        padding: 11px 16px;
        border-radius: 10px;
        font-weight: 800;
    }

        .back-button:hover {
            color: white;
            background: #422419;
        }


    /* =====================================================
           MENSAGENS
        ===================================================== */

    .success {
        margin-bottom: 20px;
        padding: 14px 18px;
        border-radius: 11px;
        background: #edf9eb;
        border: 1px solid #d4ecd1;
        color: #347b35;
        font-weight: 700;
    }

    .error {
        margin-bottom: 20px;
        padding: 14px 18px;
        border-radius: 11px;
        background: #fff0ee;
        border: 1px solid #f0d0cc;
        color: #a7372d;
        font-weight: 700;
    }


    /* =====================================================
           RESUMO
        ===================================================== */

    .users-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #eadfd4;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 10px 35px rgba(50,30,17,.05);
    }

        .summary-card span {
            display: block;
            color: #786a60;
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 7px;
        }

        .summary-card strong {
            color: #2b170d;
            font-size: 30px;
        }


    /* =====================================================
           TABELA
        ===================================================== */

    .users-box {
        background: white;
        border: 1px solid #eadfd4;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(50,30,17,.05);
    }

    .users-box-header {
        padding: 23px 25px;
        border-bottom: 1px solid #eee5dd;
    }

        .users-box-header h2 {
            margin: 0;
            color: #2b170d;
            font-size: 20px;
        }

        .users-box-header p {
            margin: 5px 0 0;
            color: #786a60;
            font-size: 13px;
        }

    .table-scroll {
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        min-width: 1100px;
        border-collapse: collapse;
    }

        .users-table th {
            text-align: left;
            padding: 13px 16px;
            background: #faf7f3;
            color: #786a60;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .users-table td {
            padding: 15px 16px;
            border-top: 1px solid #f1ebe5;
            color: #49392f;
            font-size: 13px;
            vertical-align: middle;
        }

        .users-table tbody tr {
            transition: background .15s;
        }

            .users-table tbody tr:hover {
                background: #fffaf6;
            }

    .user-name {
        font-weight: 800;
        color: #2b170d;
    }

    .user-email {
        display: block;
        margin-top: 3px;
        color: #8b7d73;
        font-size: 12px;
    }


    /* =====================================================
           BADGES
        ===================================================== */

    .badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
    }

    .badge-free {
        background: #edf8eb;
        color: #347b35;
    }

    .badge-premium {
        background: #fff0e4;
        color: #d84f09;
    }

    .badge-admin {
        background: #eee7ff;
        color: #6542a6;
        margin-left: 5px;
    }

    .badge-active {
        background: #edf8eb;
        color: #347b35;
    }

    .badge-inactive {
        background: #fff0ee;
        color: #b33b30;
    }

    .usage-text {
        font-weight: 800;
        color: #2b170d;
    }

    .usage-sub {
        display: block;
        margin-top: 3px;
        color: #8b7e74;
        font-size: 11px;
    }


    /* =====================================================
           AÇÕES
        ===================================================== */

    .user-actions {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
        align-items: center;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 0;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
        cursor: pointer;
        transition: transform .15s, opacity .15s;
    }

        .action-btn:hover {
            transform: translateY(-1px);
        }

    .action-edit {
        background: #2b170d;
        color: white;
    }

        .action-edit:hover {
            color: white;
        }

    .action-password {
        background: #f5661b;
        color: white;
    }

        .action-password:hover {
            color: white;
        }

    .action-delete {
        background: #b9362c;
        color: white;
    }

        .action-delete:hover {
            background: #9d2d25;
            color: white;
        }

    .delete-form {
        display: inline;
        margin: 0;
        padding: 0;
    }

    .current-user-info {
        display: inline-flex;
        align-items: center;
        padding: 7px 10px;
        border-radius: 8px;
        background: #f1eee9;
        color: #8a7b70;
        font-size: 10px;
        font-weight: 800;
        cursor: default;
    }


    /* =====================================================
           VAZIO
        ===================================================== */

    .empty {
        padding: 50px 25px;
        text-align: center;
        color: #8b7e74;
    }


    /* =====================================================
           RESPONSIVO
        ===================================================== */

    @@media(max-width: 850px) {

        .users-summary {
            grid-template-columns: 1fr;
        }

        .users-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }

</style>


<div class="users-admin">


    <!-- =====================================================
         CABEÇALHO
    ====================================================== -->

    <div class="users-header">

        <div>

            <h1>
                👥 Usuários
            </h1>

            <p>
                Gerencie contas gratuitas, Premium
                e administradores.
            </p>

        </div>


        <a asp-controller="Admin"
           asp-action="Index"
           class="back-button">

            ← Painel

        </a>

    </div>


    <!-- =====================================================
         MENSAGENS
    ====================================================== -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="success">
            ✅ @TempData["Sucesso"]
        </div>
    }


    @if (TempData["Erro"] != null)
    {
        <div class="error">
            ⚠️ @TempData["Erro"]
        </div>
    }


    <!-- =====================================================
         RESUMO
    ====================================================== -->

    <div class="users-summary">

        <div class="summary-card">

            <span>
                TOTAL DE USUÁRIOS
            </span>

            <strong>
                @totalUsuarios
            </strong>

        </div>


        <div class="summary-card">

            <span>
                🌿 GRATUITO
            </span>

            <strong>
                @totalFree
            </strong>

        </div>


        <div class="summary-card">

            <span>
                👑 PREMIUM
            </span>

            <strong>
                @totalPremium
            </strong>

        </div>

    </div>


    <!-- =====================================================
         USUÁRIOS
    ====================================================== -->

    <section class="users-box">

        <div class="users-box-header">

            <h2>
                Contas cadastradas
            </h2>

            <p>
                Altere plano, status, dados, senha
                ou exclua contas.
            </p>

        </div>


        @if (Model.Count == 0)
        {
            <div class="empty">

                👨‍🍳

                <br /><br />

                Nenhum usuário cadastrado.

            </div>
        }
        else
        {
            <div class="table-scroll">

                <table class="users-table">

                    <thead>

                        <tr>

                            <th>
                                Usuário
                            </th>

                            <th>
                                Plano
                            </th>

                            <th>
                                Consultas
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Cadastro
                            </th>

                            <th>
                                Último acesso
                            </th>

                            <th>
                                Ações
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- USUÁRIO -->

                                <td>

                                    <span class="user-name">
                                        @item.Name
                                    </span>


                                    @if (item.IsAdmin)
                                    {
                                        <span class="badge badge-admin">
                                            ADMIN
                                        </span>
                                    }


                                    <span class="user-email">
                                        @item.Email
                                    </span>

                                </td>


                                <!-- PLANO -->

                                <td>

                                    @if (item.PlanCode == "PREMIUM")
                                    {
                                        <span class="badge badge-premium">
                                            👑 Premium
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-free">
                                            🌿 Gratuito
                                        </span>
                                    }

                                </td>


                                <!-- CONSULTAS -->

                                <td>

                                    <span class="usage-text">

                                        @item.ConsultasUsadasMes
                                        /
                                        @item.LimiteMensal

                                    </span>

                                    <span class="usage-sub">
                                        @item.ConsultasRestantes restantes
                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-active">
                                            ✓ Ativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive">
                                            ✕ Desativado
                                        </span>
                                    }

                                </td>


                                <!-- CADASTRO -->

                                <td>

                                    @(item.CreatedAt
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy"))

                                </td>


                                <!-- ÚLTIMO ACESSO -->

                                <td>

                                    @if (item.LastLoginAt.HasValue)
                                    {
                                        @(item.LastLoginAt.Value
                                            .ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm"))
                                    }
                                    else
                                    {
                                        <span>
                                            Nunca
                                        </span>
                                    }

                                </td>


                                <!-- AÇÕES -->

                                <td>

                                    <div class="user-actions">

                                        <a asp-controller="Admin"
                                           asp-action="EditarUsuario"
                                           asp-route-id="@item.Id"
                                           class="action-btn action-edit">

                                            ✏️ Editar

                                        </a>


                                        <a asp-controller="Admin"
                                           asp-action="ResetSenha"
                                           asp-route-id="@item.Id"
                                           class="action-btn action-password">

                                            🔑 Senha

                                        </a>


                                        @if (item.Id != usuarioAtualId)
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="ExcluirUsuario"
                                                  method="post"
                                                  class="delete-form"
                                                  onsubmit="return confirm('Tem certeza que deseja excluir @item.Name? Esta ação é permanente e não poderá ser desfeita.');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <button type="submit"
                                                        class="action-btn action-delete">

                                                    🗑️ Excluir

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="current-user-info">
                                                🔒 Sua conta
                                            </span>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>