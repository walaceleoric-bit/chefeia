@model chefeia.Models.AdminPlanosViewModel

@{
    ViewData["Title"] = "Planos";
}

<style>

    body {
        background: #f5f1eb;
    }

    .plans-admin {
        max-width: 1050px;
        margin: 40px auto 80px;
        padding: 0 20px;
    }

    .plans-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .plans-header h1 {
        margin: 0;
        color: #2b170d;
    }

    .plans-header p {
        margin: 7px 0 0;
        color: #786a60;
    }

    .back-button {
        text-decoration: none;
        padding: 11px 16px;
        border-radius: 10px;
        color: white;
        background: #2b170d;
        font-weight: 800;
    }

    .success {
        margin-bottom: 20px;
        padding: 14px 18px;
        border-radius: 11px;
        background: #edf9eb;
        color: #347b35;
    }

    .plans-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }

    .plan-box {
        position: relative;
        background: white;
        border: 1px solid #eadfd4;
        border-radius: 22px;
        padding: 30px;
        box-shadow:
            0 12px 40px rgba(50,30,17,.06);
    }

    .plan-box.premium {
        border: 2px solid #f5661b;
    }

    .premium-tag {
        position: absolute;
        top: 18px;
        right: 18px;
        padding: 6px 10px;
        border-radius: 30px;
        color: #d84f09;
        background: #fff0e4;
        font-size: 10px;
        font-weight: 900;
    }

    .plan-icon {
        font-size: 40px;
    }

    .plan-box h2 {
        margin: 9px 0 4px;
        color: #2b170d;
    }

    .plan-description {
        margin: 0 0 25px;
        color: #786a60;
        font-size: 14px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-bottom: 19px;
    }

    .field label {
        color: #2b170d;
        font-weight: 800;
    }

    .field input[type="number"] {
        padding: 13px;
        border: 1px solid #ddd1c6;
        border-radius: 10px;
        font-size: 16px;
    }

    .check-field {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 13px 0;
        border-top: 1px solid #f1eae4;
    }

    .check-field div {
        display: flex;
        flex-direction: column;
    }

    .check-field strong {
        color: #2b170d;
    }

    .check-field small {
        margin-top: 3px;
        color: #8b7e74;
    }

    .check-field input {
        width: 20px;
        height: 20px;
    }

    .save-area {
        margin-top: 25px;
        display: flex;
        justify-content: flex-end;
    }

    .save-button {
        border: 0;
        border-radius: 11px;
        padding: 14px 25px;
        background: #f5661b;
        color: white;
        font-weight: 900;
        cursor: pointer;
    }

    @@media(max-width: 800px) {

        .plans-grid {
            grid-template-columns: 1fr;
        }

        .plans-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }

</style>


<div class="plans-admin">

    <div class="plans-header">

        <div>

            <h1>
                👑 Planos
            </h1>

            <p>
                Controle os recursos de cada plano.
            </p>

        </div>


        <a
            asp-controller="Admin"
            asp-action="Index"
            class="back-button">

            ← Painel

        </a>

    </div>


    @if (TempData["Sucesso"] != null)
    {
        <div class="success">
            ✅ @TempData["Sucesso"]
        </div>
    }


    <form
        asp-controller="Admin"
        asp-action="Planos"
        method="post">

        @Html.AntiForgeryToken()

        <input
            asp-for="FreeId"
            type="hidden" />

        <input
            asp-for="PremiumId"
            type="hidden" />


        <div class="plans-grid">

            <!-- GRATUITO -->

            <article class="plan-box">

                <div class="plan-icon">
                    🌿
                </div>

                <h2>
                    Gratuito
                </h2>

                <p class="plan-description">
                    Plano de entrada do Chefe IA.
                </p>


                <div class="field">

                    <label asp-for="FreeMonthlyLimit">
                        Consultas por mês
                    </label>

                    <input
                        asp-for="FreeMonthlyLimit"
                        type="number"
                        min="0" />

                </div>


                <div class="check-field">

                    <div>

                        <strong>
                            📢 Anúncios
                        </strong>

                        <small>
                            Exibir publicidade
                        </small>

                    </div>

                    <input
                        asp-for="FreeHasAds"
                        type="checkbox" />

                </div>


                <div class="check-field">

                    <div>

                        <strong>
                            🕘 Histórico
                        </strong>

                        <small>
                            Permitir histórico de receitas
                        </small>

                    </div>

                    <input
                        asp-for="FreeHasHistory"
                        type="checkbox" />

                </div>


                <div class="check-field">

                    <div>

                        <strong>
                            📥 Download
                        </strong>

                        <small>
                            Permitir baixar receitas
                        </small>

                    </div>

                    <input
                        asp-for="FreeCanDownloadRecipes"
                        type="checkbox" />

                </div>


                <div class="check-field">

                    <div>

                        <strong>
                            ✅ Plano ativo
                        </strong>

                        <small>
                            Permitir novas contas gratuitas
                        </small>

                    </div>

                    <input
                        asp-for="FreeIsActive"
                        type="checkbox" />

                </div>

            </article>


            <!-- PREMIUM -->

            <article class="plan-box premium">

                <div class="premium-tag">
                    👑 PREMIUM
                </div>

                <div class="plan-icon">
                    ⭐
                </div>

                <h2>
                    Premium
                </h2>

                <p class="plan-description">
                    Plano completo do Chefe IA.
                </p>


                <div class="field">

                    <label asp-for="PremiumMonthlyLimit">
                        Consultas por mês
                    </label>

                    <input
                        asp-for="PremiumMonthlyLimit"
                        type="number"
                        min="0" />

                </div>


                <div class="field">

                    <label asp-for="PremiumPrice">
                        Preço mensal
                    </label>

                    <input
                        asp-for="PremiumPrice"
                        type="number"
                        min="0"
                        step="0.01" />

                </div>


                <div class="check-field">

                    <div>

                        <strong>
                            📢 Anúncios
                        </strong>

                        <small>
                            Exibir publicidade
                        </small>

                    </div>

                    <input
                        asp-for="PremiumHasAds"
                        type="checkbox" />

                </div>


                <div class="check-field">

                    <div>

                        <strong>
                            🕘 Histórico
                        </strong>

                        <small>
                            Guardar receitas do usuário
                        </small>

                    </div>

                    <input
                        asp-for="PremiumHasHistory"
                        type="checkbox" />

                </div>


                <div class="check-field">

                    <div>

                        <strong>
                            📥 Download
                        </strong>

                        <small>
                            Permitir baixar receitas
                        </small>

                    </div>

                    <input
                        asp-for="PremiumCanDownloadRecipes"
                        type="checkbox" />

                </div>


                <div class="check-field">

                    <div>

                        <strong>
                            ✅ Plano ativo
                        </strong>

                        <small>
                            Disponibilizar plano Premium
                        </small>

                    </div>

                    <input
                        asp-for="PremiumIsActive"
                        type="checkbox" />

                </div>

            </article>

        </div>


        <div class="save-area">

            <button
                type="submit"
                class="save-button">

                💾 Salvar planos

            </button>

        </div>

    </form>

</div>