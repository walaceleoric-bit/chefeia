@model chefeia.Models.AdminConsumoViewModel

@{
    ViewData["Title"] = "Consumo da IA";
}

<style>

    body {
        background: #f5f1eb;
    }

    .consumo-admin {
        max-width: 1250px;
        margin: 35px auto 80px;
        padding: 0 20px;
    }

    .consumo-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .consumo-header h1 {
        margin: 0;
        color: #2b170d;
        font-size: 34px;
    }

    .consumo-header p {
        margin: 7px 0 0;
        color: #786a60;
    }

    .voltar-admin {
        text-decoration: none;
        background: #2b170d;
        color: white;
        padding: 11px 17px;
        border-radius: 10px;
        font-weight: 800;
    }

    .cards-consumo {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .consumo-card {
        background: white;
        border: 1px solid #eadfd4;
        border-radius: 19px;
        padding: 24px;
        box-shadow:
            0 10px 35px rgba(50,30,17,.05);
    }

    .consumo-card .icone {
        font-size: 29px;
        margin-bottom: 12px;
    }

    .consumo-card .titulo {
        color: #786a60;
        font-size: 13px;
        font-weight: 800;
    }

    .consumo-card .valor {
        margin-top: 7px;
        color: #2b170d;
        font-size: 32px;
        font-weight: 900;
    }

    .consumo-card .detalhe {
        margin-top: 5px;
        color: #9a8d84;
        font-size: 12px;
    }


    /* =========================================
       RAPIDAPI
    ========================================= */

    .rapid-box {
        margin-bottom: 25px;
        padding: 28px;
        border-radius: 22px;
        color: white;
        background:
            linear-gradient(
                135deg,
                #28140a,
                #4a2918
            );
    }

    .rapid-box h2 {
        margin: 0 0 6px;
    }

    .rapid-box > p {
        margin: 0 0 23px;
        color: rgba(255,255,255,.65);
    }

    .rapid-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 17px;
    }

    .rapid-card {
        padding: 20px;
        border-radius: 16px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.09);
    }

    .rapid-card-title {
        color: rgba(255,255,255,.65);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .8px;
    }

    .rapid-numbers {
        margin-top: 9px;
        font-size: 29px;
        font-weight: 900;
    }

    .rapid-numbers small {
        font-size: 14px;
        font-weight: normal;
        color: rgba(255,255,255,.55);
    }

    .progress {
        height: 8px;
        margin-top: 15px;
        overflow: hidden;
        border-radius: 20px;
        background: rgba(255,255,255,.13);
    }

    .progress-bar {
        height: 100%;
        border-radius: 20px;
        background: #f5661b;
    }


    /* =========================================
       TABELA
    ========================================= */

    .table-box {
        background: white;
        border: 1px solid #eadfd4;
        border-radius: 22px;
        overflow: hidden;
        box-shadow:
            0 10px 35px rgba(50,30,17,.05);
    }

    .table-title {
        padding: 24px 25px;
        border-bottom: 1px solid #eee5dc;
    }

    .table-title h2 {
        margin: 0;
        color: #2b170d;
        font-size: 21px;
    }

    .table-title p {
        margin: 5px 0 0;
        color: #786a60;
        font-size: 13px;
    }

    .table-scroll {
        overflow-x: auto;
    }

    .usage-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

    .usage-table th {
        padding: 13px 17px;
        text-align: left;
        background: #faf7f3;
        color: #786a60;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .usage-table td {
        padding: 15px 17px;
        border-top: 1px solid #f1ebe5;
        color: #49392f;
        font-size: 13px;
    }

    .status-ok {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        background: #edf8eb;
        color: #347b35;
        font-weight: 800;
        font-size: 11px;
    }

    .status-erro {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        background: #fff0ee;
        color: #b33b30;
        font-weight: 800;
        font-size: 11px;
    }

    .sem-dados {
        padding: 50px 25px;
        text-align: center;
        color: #8a7c72;
    }

    .sem-dados-icone {
        display: block;
        margin-bottom: 10px;
        font-size: 42px;
    }

    @@media(max-width: 900px) {

        .cards-consumo {
            grid-template-columns: 1fr 1fr;
        }

        .rapid-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width: 600px) {

        .consumo-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .cards-consumo {
            grid-template-columns: 1fr;
        }
    }

</style>


@{
    var requestsPercentual = 0.0;

    if (Model.RequestsLimit.HasValue &&
        Model.RequestsLimit.Value > 0 &&
        Model.RequestsRemaining.HasValue)
    {
        requestsPercentual =
            (double)Model.RequestsRemaining.Value /
            Model.RequestsLimit.Value *
            100;

        requestsPercentual =
            Math.Clamp(
                requestsPercentual,
                0,
                100);
    }


    var creditPercentual = 0.0;

    if (Model.CreditLimit.HasValue &&
        Model.CreditLimit.Value > 0 &&
        Model.CreditRemaining.HasValue)
    {
        creditPercentual =
            (double)Model.CreditRemaining.Value /
            Model.CreditLimit.Value *
            100;

        creditPercentual =
            Math.Clamp(
                creditPercentual,
                0,
                100);
    }
}


<div class="consumo-admin">

    <!-- =========================================
         CABEÇALHO
    ========================================== -->

    <div class="consumo-header">

        <div>

            <h1>
                📊 Consumo da IA
            </h1>

            <p>
                Acompanhe as consultas realizadas
                e o consumo da RapidAPI.
            </p>

        </div>


        <a
            asp-controller="Admin"
            asp-action="Index"
            class="voltar-admin">

            ← Painel

        </a>

    </div>


    <!-- =========================================
         RESUMO
    ========================================== -->

    <div class="cards-consumo">

        <article class="consumo-card">

            <div class="icone">
                📅
            </div>

            <div class="titulo">
                CONSULTAS HOJE
            </div>

            <div class="valor">
                @Model.ConsultasHoje
            </div>

            <div class="detalhe">
                Consultas registradas hoje
            </div>

        </article>


        <article class="consumo-card">

            <div class="icone">
                🗓️
            </div>

            <div class="titulo">
                ESTE MÊS
            </div>

            <div class="valor">
                @Model.ConsultasMes
            </div>

            <div class="detalhe">
                Total mensal
            </div>

        </article>


        <article class="consumo-card">

            <div class="icone">
                📈
            </div>

            <div class="titulo">
                TOTAL
            </div>

            <div class="valor">
                @Model.ConsultasTotal
            </div>

            <div class="detalhe">
                Desde o início do monitoramento
            </div>

        </article>


        <article class="consumo-card">

            <div class="icone">
                ✅
            </div>

            <div class="titulo">
                SUCESSOS NO MÊS
            </div>

            <div class="valor">
                @Model.SucessosMes
            </div>

            <div class="detalhe">
                Consultas concluídas
            </div>

        </article>


        <article class="consumo-card">

            <div class="icone">
                ❌
            </div>

            <div class="titulo">
                ERROS NO MÊS
            </div>

            <div class="valor">
                @Model.ErrosMes
            </div>

            <div class="detalhe">
                Consultas com falha
            </div>

        </article>


        <article class="consumo-card">

            <div class="icone">
                ⏱️
            </div>

            <div class="titulo">
                TEMPO MÉDIO
            </div>

            <div class="valor">

                @(
                    (Model.TempoMedioMs / 1000)
                        .ToString("N1")
                )s

            </div>

            <div class="detalhe">
                Tempo médio da IA neste mês
            </div>

        </article>

    </div>


    <!-- =========================================
         RAPIDAPI
    ========================================== -->

    <section class="rapid-box">

        <h2>
            ⚡ RapidAPI
        </h2>

        <p>
            Últimos limites informados pela API.
        </p>


        <div class="rapid-grid">

            <!-- REQUESTS -->

            <div class="rapid-card">

                <div class="rapid-card-title">
                    Requests restantes
                </div>

                @if (
                    Model.RequestsRemaining.HasValue &&
                    Model.RequestsLimit.HasValue)
                {
                    <div class="rapid-numbers">

                        @Model.RequestsRemaining

                        <small>
                            / @Model.RequestsLimit
                        </small>

                    </div>


                    <div class="progress">

                        <div
                            class="progress-bar"
                            style="width:@requestsPercentual.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                        </div>

                    </div>
                }
                else
                {
                    <div class="rapid-numbers">
                        —

                        <small>
                            aguardando consulta
                        </small>
                    </div>
                }

            </div>


            <!-- CRÉDITOS -->

            <div class="rapid-card">

                <div class="rapid-card-title">
                    Créditos restantes
                </div>

                @if (
                    Model.CreditRemaining.HasValue &&
                    Model.CreditLimit.HasValue)
                {
                    <div class="rapid-numbers">

                        @Model.CreditRemaining

                        <small>
                            / @Model.CreditLimit
                        </small>

                    </div>


                    <div class="progress">

                        <div
                            class="progress-bar"
                            style="width:@creditPercentual.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                        </div>

                    </div>
                }
                else
                {
                    <div class="rapid-numbers">
                        —

                        <small>
                            aguardando consulta
                        </small>
                    </div>
                }

            </div>

        </div>

    </section>


    <!-- =========================================
         ÚLTIMAS CONSULTAS
    ========================================== -->

    <section class="table-box">

        <div class="table-title">

            <h2>
                🧾 Últimas consultas
            </h2>

            <p>
                As 50 consultas mais recentes
                registradas no sistema.
            </p>

        </div>


        @if (
            Model.UltimasConsultas == null ||
            Model.UltimasConsultas.Count == 0)
        {
            <div class="sem-dados">

                <span class="sem-dados-icone">
                    👨‍🍳
                </span>

                Nenhuma consulta registrada ainda.

            </div>
        }
        else
        {
            <div class="table-scroll">

                <table class="usage-table">

                    <thead>

                        <tr>

                            <th>
                                Data
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                HTTP
                            </th>

                            <th>
                                Ingredientes
                            </th>

                            <th>
                                Porções
                            </th>

                            <th>
                                Tempo
                            </th>

                            <th>
                                Requests
                            </th>

                            <th>
                                Créditos
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var item
                            in Model.UltimasConsultas)
                        {
                            <tr>

                                <td>

                                    @item.CreatedAt
                                        .ToLocalTime()
                                        .ToString(
                                            "dd/MM/yyyy HH:mm"
                                        )

                                </td>


                                <td>

                                    @if (item.Success)
                                    {
                                        <span class="status-ok">
                                            ✓ Sucesso
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-erro">
                                            ✕ Erro
                                        </span>
                                    }

                                </td>


                                <td>

                                    @(
                                        item.StatusCode
                                            ?.ToString()
                                        ?? "-"
                                    )

                                </td>


                                <td>
                                    @item.IngredientCount
                                </td>


                                <td>
                                    @item.Servings
                                </td>


                                <td>

                                    @(
                                        (item.DurationMs / 1000.0)
                                            .ToString("N1")
                                    )s

                                </td>


                                <td>

                                    @if (
                                        item.RequestsRemaining.HasValue &&
                                        item.RequestsLimit.HasValue)
                                    {
                                        <span>
                                            @item.RequestsRemaining
                                            /
                                            @item.RequestsLimit
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (
                                        item.CreditRemaining.HasValue &&
                                        item.CreditLimit.HasValue)
                                    {
                                        <span>
                                            @item.CreditRemaining
                                            /
                                            @item.CreditLimit
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>