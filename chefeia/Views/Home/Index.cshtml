@model chefeia.Models.HomeViewModel

@{
    ViewData["Title"] = Model.Settings.SiteName;
}

<link rel="stylesheet" href="~/css/home.css" />


<!-- =========================================================
     HERO PRINCIPAL + CHEFE IA
========================================================= -->

<section class="chef-hero">

    <div class="hero-copy">

        <div class="brand-pill">
            👨‍🍳 @Model.Settings.SiteName
        </div>

        <span class="hero-kicker">
            ✨ COZINHE COM INTELIGÊNCIA ARTIFICIAL
        </span>

        <h1>
            O que você tem
            <span>em casa?</span>
        </h1>

        <p class="hero-subtitle">
            Adicione os ingredientes disponíveis e deixe o
            Chefe IA analisar as melhores possibilidades para você.
        </p>


        <!-- =====================================================
             FORMULÁRIO DA IA
        ====================================================== -->

        <div class="hero-ai-box">

            <div class="hero-ingredient-input">

                <input id="ingredienteIA"
                       type="text"
                       placeholder="Ex: ovo, arroz, queijo..." />

                <button id="btnAdicionarIngrediente"
                        type="button">

                    + Adicionar

                </button>

            </div>


            <div id="listaIngredientes"
                 class="lista-ingredientes">
            </div>


            <div class="hero-options">

                <div class="hero-option">

                    <label for="preferenciaIA">
                        🍽️ Preferência
                    </label>

                    <select id="preferenciaIA">

                        <option value="">
                            Qualquer
                        </option>

                        <option value="prato principal">
                            Prato principal
                        </option>

                        <option value="sobremesa">
                            Sobremesa
                        </option>

                        <option value="bolo">
                            Bolo
                        </option>

                        <option value="doce">
                            Doce
                        </option>

                        <option value="salgado">
                            Salgado
                        </option>

                        <option value="rápido">
                            Rápido
                        </option>

                        <option value="saudável">
                            Saudável
                        </option>

                    </select>

                </div>


                <div class="hero-option">

                    <label for="porcoesIA">
                        👥 Porções
                    </label>

                    <input id="porcoesIA"
                           type="number"
                           value="4"
                           min="1"
                           max="20" />

                </div>

            </div>


            <button id="btnDescobrirIA"
                    class="hero-ai-button"
                    type="button">

                ✨ Criar minha receita

            </button>


            <div class="hero-usage">

                🌿 Gratuito:

                <strong>
                    @Model.Settings.FreeMonthlyLimit
                    consultas por mês
                </strong>

            </div>


            <div id="statusIA"></div>

        </div>

    </div>

</section>



<!-- =========================================================
     OPINIÃO / ORIENTAÇÃO DO CHEFE IA
========================================================= -->

<section class="section chef-opinion-section"
         id="orientacaoIA"
         style="display:none;">

    <article class="chef-opinion-card">

        <div class="chef-opinion-icon">
            👨‍🍳
        </div>


        <div class="chef-opinion-content">

            <span class="section-kicker"
                  id="tituloOrientacaoIA">

                OPINIÃO DO CHEFE IA

            </span>


            <h2 id="subtituloOrientacaoIA">
                Antes de cozinhar...
            </h2>


            <p id="mensagemOrientacaoIA">
            </p>


            <div id="blocoSugestoesIA"
                 style="display:none;">

                <h3>
                    💡 Você pode melhorar adicionando:
                </h3>

                <ul id="sugestoesIA">
                </ul>

            </div>


            <div class="chef-opinion-tip">

                <strong>
                    Dica:
                </strong>

                você pode adicionar mais ingredientes acima
                e pedir uma nova análise.

            </div>

        </div>

    </article>

</section>



<!-- =========================================================
     RESULTADO DA IA
========================================================= -->

<section class="section generated-section"
         id="resultadoIA"
         style="display:none;">

    <div class="section-heading">

        <div>

            <span class="section-kicker">
                ✨ RECEITA PERSONALIZADA
            </span>

            <h2>
                Sua receita está pronta
            </h2>

            <p>
                Criada especialmente a partir dos ingredientes
                que você informou.
            </p>

        </div>

    </div>


    <article class="generated-recipe">

        <div class="generated-top">

            <div>

                <span id="paisReceitaIA"
                      class="generated-country">
                </span>

                <h3 id="nomeReceitaIA">
                </h3>

                <p id="descricaoReceitaIA">
                </p>

            </div>


            <div class="generated-chef">
                👨‍🍳
            </div>

        </div>


        <div class="generated-meta">

            <span id="categoriaReceitaIA">
            </span>

            <span id="tempoReceitaIA">
            </span>

            <span id="porcoesReceitaIA">
            </span>

        </div>


        <div class="recipe-columns">

            <div class="recipe-column ingredients-column">

                <h4>
                    🛒 Ingredientes
                </h4>

                <ul id="ingredientesReceitaIA">
                </ul>

            </div>


            <div class="recipe-column steps-column">

                <h4>
                    👨‍🍳 Modo de preparo
                </h4>

                <ol id="passosReceitaIA">
                </ol>

            </div>

        </div>

    </article>

</section>



<!-- =========================================================
     BENEFÍCIOS
========================================================= -->

<section class="feature-grid">

    <article class="feature-card">

        <div class="feature-emoji">
            @Model.Settings.Feature1Emoji
        </div>

        <h3>
            @Model.Settings.Feature1Title
        </h3>

        <p>
            @Model.Settings.Feature1Text
        </p>

    </article>


    <article class="feature-card">

        <div class="feature-emoji">
            @Model.Settings.Feature2Emoji
        </div>

        <h3>
            @Model.Settings.Feature2Title
        </h3>

        <p>
            @Model.Settings.Feature2Text
        </p>

    </article>


    <article class="feature-card">

        <div class="feature-emoji">
            @Model.Settings.Feature3Emoji
        </div>

        <h3>
            @Model.Settings.Feature3Title
        </h3>

        <p>
            @Model.Settings.Feature3Text
        </p>

    </article>


    <article class="feature-card">

        <div class="feature-emoji">
            @Model.Settings.Feature4Emoji
        </div>

        <h3>
            @Model.Settings.Feature4Title
        </h3>

        <p>
            @Model.Settings.Feature4Text
        </p>

    </article>

</section>



<!-- =========================================================
     COMO FUNCIONA
========================================================= -->

<section class="how-section">

    <div class="section-heading center">

        <div>

            <span class="section-kicker">
                👨‍🍳 MUITO SIMPLES
            </span>

            <h2>
                Como funciona?
            </h2>

            <p>
                Da sua geladeira para uma nova receita
                em poucos passos.
            </p>

        </div>

    </div>


    <div class="how-grid">

        <article class="how-card">

            <span class="how-number">
                01
            </span>

            <div class="how-icon">
                🧺
            </div>

            <h3>
                Informe
            </h3>

            <p>
                Adicione os ingredientes
                que você tem disponível.
            </p>

        </article>


        <article class="how-card">

            <span class="how-number">
                02
            </span>

            <div class="how-icon">
                ✨
            </div>

            <h3>
                Analise
            </h3>

            <p>
                Nossa IA avalia os ingredientes
                e encontra uma opção coerente.
            </p>

        </article>


        <article class="how-card">

            <span class="how-number">
                03
            </span>

            <div class="how-icon">
                🍲
            </div>

            <h3>
                Cozinhe
            </h3>

            <p>
                Quando houver uma boa receita,
                siga o passo a passo.
            </p>

        </article>


        <article class="how-card">

            <span class="how-number">
                04
            </span>

            <div class="how-icon">
                😋
            </div>

            <h3>
                Aproveite
            </h3>

            <p>
                Descubra novos sabores
                todos os dias.
            </p>

        </article>

    </div>

</section>



<!-- =========================================================
     PLANOS
========================================================= -->

<section class="plans-section"
         id="planos">

    <div class="section-heading center">

        <div>

            <span class="section-kicker">
                👑 PLANOS
            </span>

            <h2>
                Escolha sua experiência
            </h2>

            <p>
                Comece gratuitamente e faça upgrade quando quiser.
            </p>

        </div>

    </div>


    <div class="plans-grid">

        <!-- GRATUITO -->

        <article class="plan-card">

            <div class="plan-header">

                <div class="plan-icon">
                    🌿
                </div>

                <div>

                    <span class="plan-type">
                        PARA EXPERIMENTAR
                    </span>

                    <h3>
                        Gratuito
                    </h3>

                </div>

            </div>


            <div class="plan-limit">

                @Model.Settings.FreeMonthlyLimit

                <small>
                    consultas por mês
                </small>

            </div>


            <ul>

                <li>
                    ✓ Receitas criadas com IA
                </li>

                <li>
                    ✓ Escolha de porções
                </li>

                <li>
                    ✓ Escolha da preferência
                </li>

                <li class="disabled">
                    ✕ Sem histórico
                </li>

                <li class="disabled">
                    ✕ Sem download
                </li>

                <li class="disabled">
                    ✕ Com anúncios
                </li>

            </ul>


            <div class="free-plan-label">
                Sempre grátis
            </div>

        </article>


        <!-- PREMIUM -->

        <article class="plan-card premium-card">

            <div class="premium-tag">
                👑 MAIS COMPLETO
            </div>


            <div class="plan-header">

                <div class="plan-icon">
                    ⭐
                </div>

                <div>

                    <span class="plan-type">
                        PARA QUEM AMA COZINHAR
                    </span>

                    <h3>
                        Premium
                    </h3>

                </div>

            </div>


            <div class="plan-limit">

                @Model.Settings.PremiumMonthlyLimit

                <small>
                    consultas por mês
                </small>

            </div>


            <ul>

                <li>
                    ✓ Sem anúncios
                </li>

                <li>
                    ✓ Histórico das receitas
                </li>

                <li>
                    ✓ Download das receitas
                </li>

                <li>
                    ✓ Favoritos
                </li>

                <li>
                    ✓ Conta pessoal
                </li>

                <li>
                    ✓ Recursos Premium
                </li>

            </ul>


            <div class="premium-price">

                <small>
                    R$
                </small>

                @Model.Settings.PremiumPrice.ToString("N2")

                <span>
                    /mês
                </span>

            </div>


            <a asp-controller="Assinatura"
               asp-action="Premium"
               class="premium-button">

                👑 Assinar Premium

            </a>

        </article>

    </div>

</section>



<!-- =========================================================
     ESTILO DA OPINIÃO DO CHEFE IA
========================================================= -->

<style>

    .chef-opinion-section {
        max-width: 1180px;
        margin: 45px auto;
        padding: 0 24px;
    }

    .chef-opinion-card {
        display: flex;
        align-items: flex-start;
        gap: 24px;
        padding: 32px;
        background: #fffaf5;
        border: 1px solid #eadfd4;
        border-radius: 24px;
        box-shadow: 0 14px 40px rgba(50, 30, 17, .08);
    }

    .chef-opinion-icon {
        width: 72px;
        height: 72px;
        min-width: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #f5661b;
        font-size: 38px;
        box-shadow: 0 10px 25px rgba(245, 102, 27, .20);
    }

    .chef-opinion-content {
        flex: 1;
    }

        .chef-opinion-content h2 {
            margin: 8px 0 10px;
            color: #2b170d;
            font-size: 28px;
        }

        .chef-opinion-content > p {
            margin: 0;
            color: #65564c;
            font-size: 16px;
            line-height: 1.7;
        }

    #blocoSugestoesIA {
        margin-top: 24px;
        padding: 20px;
        background: white;
        border: 1px solid #eee3d9;
        border-radius: 16px;
    }

        #blocoSugestoesIA h3 {
            margin: 0 0 13px;
            color: #2b170d;
            font-size: 16px;
        }

    #sugestoesIA {
        margin: 0;
        padding-left: 22px;
        color: #65564c;
    }

        #sugestoesIA li {
            margin: 8px 0;
            line-height: 1.5;
        }

    .chef-opinion-tip {
        margin-top: 20px;
        padding: 13px 16px;
        background: #f3eee8;
        border-radius: 12px;
        color: #65564c;
        font-size: 13px;
    }

        .chef-opinion-tip strong {
            color: #2b170d;
        }

    @@media(max-width: 700px) {

        .chef-opinion-card {
            flex-direction: column;
            padding: 24px;
        }

        .chef-opinion-icon {
            width: 60px;
            height: 60px;
            min-width: 60px;
            font-size: 31px;
        }

        .chef-opinion-content h2 {
            font-size: 23px;
        }
    }

</style>


<script src="~/js/home.js"></script>