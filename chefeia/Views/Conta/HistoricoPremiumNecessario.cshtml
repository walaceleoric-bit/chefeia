@{
    ViewData["Title"] = "Histórico Premium";
}

<style>

    body {
        background: #f5f1eb;
    }

    .premium-required {
        max-width: 720px;
        margin: 70px auto 100px;
        padding: 0 20px;
    }

    .premium-required-box {
        padding: 45px;
        text-align: center;
        background: white;
        border: 1px solid #eadfd4;
        border-radius: 25px;
        box-shadow:
            0 15px 50px rgba(50,30,17,.07);
    }

    .premium-required-icon {
        font-size: 55px;
    }

    .premium-required-box h1 {
        margin: 12px 0 8px;
        color: #2b170d;
        font-family: Georgia, serif;
        font-size: 36px;
    }

    .premium-required-box p {
        max-width: 520px;
        margin: 0 auto;
        color: #786a60;
        line-height: 1.7;
    }

    .premium-features {
        max-width: 420px;
        margin: 28px auto;
        text-align: left;
        padding: 20px;
        border-radius: 15px;
        background: #fff8ee;
    }

    .premium-features div {
        padding: 7px 0;
        color: #604637;
    }

    .premium-required-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-back {
        padding: 12px 18px;
        border-radius: 10px;
        text-decoration: none;
        background: #eee7df;
        color: #2b170d;
        font-weight: 800;
    }

    .btn-premium {
        padding: 12px 18px;
        border-radius: 10px;
        text-decoration: none;
        background: #f5661b;
        color: white;
        font-weight: 900;
    }

</style>


<div class="premium-required">

    <div class="premium-required-box">

        <div class="premium-required-icon">
            👑
        </div>

        <h1>
            Recurso Premium
        </h1>

        <p>
            O histórico de receitas está disponível
            para usuários do plano Premium.
        </p>


        <div class="premium-features">

            <div>
                ✓ Histórico das receitas criadas
            </div>

            <div>
                ✓ Até 50 consultas por mês
            </div>

            <div>
                ✓ Download das receitas
            </div>

            <div>
                ✓ Sem anúncios
            </div>

        </div>


        <div class="premium-required-actions">

            <a
                asp-controller="Home"
                asp-action="Index"
                class="btn-back">

                ← Voltar

            </a>


            <a
                asp-controller="Home"
                asp-action="Index"
                asp-fragment="planos"
                class="btn-premium">

                👑 Conhecer Premium

            </a>

        </div>

    </div>

</div>