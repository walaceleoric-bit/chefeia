@{
    ViewData["Title"] = "Plano Premium";
}

<div style="
    max-width:720px;
    margin:70px auto;
    padding:45px;
    text-align:center;
    background:white;
    border:1px solid #eadfd4;
    border-radius:25px;
">

    <div style="font-size:60px;">
        👑
    </div>

    <h1 style="color:#2b170d;">
        Você já é Premium
    </h1>

    <p style="
        color:#786a60;
        line-height:1.7;
    ">
        Sua conta já possui acesso aos recursos
        Premium do Chefe IA.
    </p>

    <a
        asp-controller="Conta"
        asp-action="Historico"
        style="
            display:inline-block;
            margin-top:18px;
            padding:12px 20px;
            border-radius:10px;
            background:#f5661b;
            color:white;
            text-decoration:none;
            font-weight:900;
        ">

        🕘 Abrir meu histórico

    </a>

</div>