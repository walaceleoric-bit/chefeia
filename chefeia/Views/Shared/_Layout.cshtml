@using chefeia.Models
@using Microsoft.AspNetCore.Identity

@inject UserManager<AppUser> UserManager

@{
    AppUser? usuarioLogado = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        usuarioLogado =
            await UserManager.GetUserAsync(User);
    }

    var isAdmin =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Admin");

    var isPremium =
        usuarioLogado?.PlanCode == "PREMIUM";
}

<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#f5661b" />

    <meta name="description"
          content="Chefe IA - transforme os ingredientes que você tem em receitas personalizadas com inteligência artificial." />

    <title>
        @ViewData["Title"] - Chefe IA
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/chefeia.styles.css"
          asp-append-version="true" />

    <style>

            /* =====================================================
                       CABEÇALHO
                    ====================================================== */

            .chefe-header {
                position: sticky;
                top: 0;
                z-index: 1000;
                width: 100%;
                background: rgba(255, 253, 249, .94);
                border-bottom: 1px solid rgba(234, 223, 212, .90);
                backdrop-filter: blur(18px);
                -webkit-backdrop-filter: blur(18px);
                box-shadow: 0 3px 20px rgba(52, 31, 18, .035);
            }

            .chefe-nav {
                width: min(1280px, calc(100% - 40px));
                min-height: 78px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                align-items: center;
                gap: 30px;
            }


            /* =====================================================
                       MARCA
                    ====================================================== */

            .chefe-logo {
                display: inline-flex;
                align-items: center;
                width: fit-content;
                gap: 12px;
                color: #2b170d;
                text-decoration: none;
            }

                .chefe-logo:hover {
                    color: #2b170d;
                    transform: translateY(-1px);
                }

            .chefe-logo-icon {
                position: relative;
                width: 48px;
                height: 48px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                border-radius: 15px;
                border: 1px solid rgba(221, 80, 8, .25);
                background: linear-gradient( 145deg, #ff842f, #f55b10 );
                font-size: 25px;
                box-shadow: 0 9px 22px rgba(245, 102, 27, .22);
            }

                .chefe-logo-icon::after {
                    content: "";
                    position: absolute;
                    inset: 2px;
                    border: 1px solid rgba(255,255,255,.25);
                    border-radius: 12px;
                    pointer-events: none;
                }

            .chefe-logo-text {
                display: flex;
                flex-direction: column;
                line-height: 1;
            }

            .chefe-logo-main {
                display: flex;
                align-items: baseline;
                gap: 4px;
            }

                .chefe-logo-main strong {
                    color: #2b170d;
                    font-size: 20px;
                    font-weight: 950;
                    letter-spacing: -.5px;
                }

                .chefe-logo-main em {
                    color: #f5661b;
                    font-size: 20px;
                    font-style: normal;
                    font-weight: 950;
                    letter-spacing: -.5px;
                }

            .chefe-logo-text small {
                margin-top: 6px;
                color: #97877c;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 1.15px;
                text-transform: uppercase;
            }


            /* =====================================================
                       MENU CENTRAL
                    ====================================================== */

            .chefe-menu {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
            }

                .chefe-menu a {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 6px;
                    padding: 10px 14px;
                    border-radius: 11px;
                    color: #5c4a3f;
                    text-decoration: none;
                    font-size: 13px;
                    font-weight: 800;
                }

                    .chefe-menu a:hover {
                        background: #f7eee6;
                        color: #2b170d;
                    }


            /* =====================================================
                       CONTA
                    ====================================================== */

            .chefe-account {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                min-width: 0;
            }

            .guest-actions,
            .logged-account {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 9px;
            }


            /* =====================================================
                       VISITANTE
                    ====================================================== */

            .btn-login,
            .btn-register {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 42px;
                padding: 10px 16px;
                border-radius: 11px;
                text-decoration: none;
                font-size: 13px;
                font-weight: 900;
            }

            .btn-login {
                border: 1px solid #ded0c5;
                background: white;
                color: #2b170d;
            }

                .btn-login:hover {
                    border-color: #cfb9a8;
                    background: #faf4ee;
                    color: #2b170d;
                }

            .btn-register {
                background: linear-gradient( 135deg, #f5661b, #ff7a2e );
                color: white;
                box-shadow: 0 8px 20px rgba(245,102,27,.18);
            }

                .btn-register:hover {
                    background: linear-gradient( 135deg, #dd5510, #f5661b );
                    color: white;
                    transform: translateY(-1px);
                }


            /* =====================================================
                       USUÁRIO LOGADO
                    ====================================================== */

            .user-info {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                min-width: 0;
                line-height: 1.05;
            }

            .user-name {
                max-width: 190px;
                overflow: hidden;
                color: #2b170d;
                font-size: 13px;
                font-weight: 900;
                white-space: nowrap;
                text-overflow: ellipsis;
            }

            .user-plan {
                display: inline-flex;
                align-items: center;
                margin-top: 5px;
                padding: 3px 7px;
                border-radius: 30px;
                font-size: 9px;
                font-weight: 900;
            }

            .user-plan-free {
                background: #eff8ed;
                color: #347b35;
            }

            .user-plan-premium {
                background: #fff0e4;
                color: #d75816;
            }

            .user-plan-admin {
                background: #f0ebff;
                color: #6747aa;
            }


            /* =====================================================
                       ADMIN
                    ====================================================== */

            .admin-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 40px;
                padding: 9px 13px;
                border-radius: 10px;
                border: 1px solid #ded4ff;
                background: #f1edff;
                color: #5c3fa1;
                text-decoration: none;
                font-size: 11px;
                font-weight: 900;
            }

                .admin-link:hover {
                    background: #e6deff;
                    color: #4d338e;
                    transform: translateY(-1px);
                }


            /* =====================================================
                       SAIR
                    ====================================================== */

            .logout-form {
                margin: 0;
            }

            .btn-logout {
                min-height: 40px;
                border: 0;
                padding: 9px 14px;
                border-radius: 10px;
                background: #2b170d;
                color: white;
                cursor: pointer;
                font-size: 12px;
                font-weight: 900;
            }

                .btn-logout:hover {
                    background: #4b2918;
                    transform: translateY(-1px);
                }


            /* =====================================================
                       CONTEÚDO
                    ====================================================== */

            .chefe-main {
                min-height: calc(100vh - 230px);
            }


            /* =====================================================
                       RODAPÉ NOVO
                    ====================================================== */

            .chefe-footer {
                width: 100%;
                margin-top: 80px;
                background: linear-gradient( 135deg, #171717 0%, #292929 50%, #171717 100% );
                border-top: 1px solid rgba(255,255,255,.08);
                box-shadow: 0 -8px 30px rgba(0,0,0,.08);
            }

            .chefe-footer-inner {
                width: min(1100px, calc(100% - 40px));
                min-height: 120px;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 55px;
                padding: 25px 0;
            }

            .footer-copyright {
                color: rgba(255,255,255,.88);
                font-size: 13px;
                font-weight: 600;
                text-align: center;
                white-space: nowrap;
            }

            .footer-divider {
                width: 1px;
                height: 26px;
                background: rgba(255,255,255,.20);
            }

            .footer-developer {
                color: rgba(255,255,255,.78);
                font-size: 13px;
                font-weight: 500;
                text-align: center;
                white-space: nowrap;
            }

                .footer-developer strong {
                    color: #ff6b1a;
                    font-size: 13px;
                    font-weight: 900;
                }


            /* =====================================================
                       TABLET
                    ====================================================== */

            @@media(max-width: 950px) {

                .chefe-nav {
                    grid-template-columns: auto 1fr auto;
                }

                .chefe-menu {
                    justify-content: center;
                }

                .user-info {
                    display: none;
                }
            }


            /* =====================================================
                       CELULAR
                    ====================================================== */

            @@media(max-width: 720px) {

                .chefe-nav {
                    width: calc(100% - 24px);
                    min-height: 68px;
                    grid-template-columns: 1fr auto;
                    gap: 10px;
                }

                .chefe-menu {
                    display: none;
                }

                .chefe-logo-icon {
                    width: 40px;
                    height: 40px;
                    font-size: 21px;
                }

                .chefe-logo-main strong,
                .chefe-logo-main em {
                    font-size: 17px;
                }

                .chefe-logo-text small {
                    display: none;
                }

                .logged-account,
                .guest-actions {
                    gap: 6px;
                }

                .admin-link {
                    padding: 8px 10px;
                    font-size: 0;
                }

                    .admin-link::after {
                        content: "⚙️";
                        font-size: 16px;
                    }

                .btn-login,
                .btn-register,
                .btn-logout {
                    padding: 8px 10px;
                    font-size: 11px;
                }
                /* RODAPÉ NO CELULAR */

                .chefe-footer {
                    margin-top: 55px;
                }

                .chefe-footer-inner {
                    min-height: 125px;
                    width: calc(100% - 30px);
                    flex-direction: column;
                    gap: 13px;
                    padding: 25px 0;
                }

                .footer-divider {
                    width: 65px;
                    height: 1px;
                }

                .footer-copyright,
                .footer-developer {
                    white-space: normal;
                    font-size: 12px;
                }

                    .footer-developer strong {
                        font-size: 12px;
                    }
            }


            /* =====================================================
                       CELULAR PEQUENO
                    ====================================================== */

            @@media(max-width: 440px) {

                .btn-register {
                    display: none;
                }

                .chefe-logo-text {
                    max-width: 120px;
                }
            }

    </style>

</head>


<body>


    <!-- =====================================================
         CABEÇALHO
    ====================================================== -->

    <header class="chefe-header">

        <nav class="chefe-nav">


            <!-- MARCA -->

            <a class="chefe-logo"
               asp-controller="Home"
               asp-action="Index">


                <span class="chefe-logo-icon">
                    👨‍🍳
                </span>


                <span class="chefe-logo-text">

                    <span class="chefe-logo-main">

                        <strong>
                            Chefe
                        </strong>

                        <em>
                            IA
                        </em>

                    </span>


                    <small>
                        Cozinhe com inteligência
                    </small>

                </span>

            </a>



            <!-- MENU -->

            <div class="chefe-menu">

                <a asp-controller="Home"
                   asp-action="Index">

                    🏠 Início

                </a>


                @if (
                    usuarioLogado != null &&
                    isPremium)
                {
                    <a asp-controller="Conta"
                       asp-action="Historico">

                        🕘 Histórico

                    </a>
                }

            </div>



            <!-- CONTA -->

            <div class="chefe-account">

                @if (
                    User.Identity?.IsAuthenticated != true ||
                    usuarioLogado == null)
                {
                    <div class="guest-actions">

                        <a asp-controller="Conta"
                           asp-action="Login"
                           class="btn-login">

                            Entrar

                        </a>


                        <a asp-controller="Conta"
                           asp-action="Cadastro"
                           class="btn-register">

                            Criar conta grátis

                        </a>

                    </div>
                }
                else
                {
                    <div class="logged-account">


                        <div class="user-info">

                            <span class="user-name">

                                Olá,
                                @(string.IsNullOrWhiteSpace(
                                    usuarioLogado.Name)
                                    ? usuarioLogado.Email
                                    : usuarioLogado.Name)

                            </span>


                            @if (isAdmin)
                            {
                                <span class="user-plan user-plan-admin">

                                    🛡️ Administrador

                                </span>
                            }
                            else if (isPremium)
                            {
                                <span class="user-plan user-plan-premium">

                                    👑 Premium

                                </span>
                            }
                            else
                            {
                                <span class="user-plan user-plan-free">

                                    🌿 Gratuito

                                </span>
                            }

                        </div>


                        @if (isAdmin)
                        {
                            <a asp-controller="Admin"
                               asp-action="Index"
                               class="admin-link">

                                ⚙️ Painel Admin

                            </a>
                        }


                        <form asp-controller="Conta"
                              asp-action="Logout"
                              method="post"
                              class="logout-form">

                            @Html.AntiForgeryToken()


                            <button type="submit"
                                    class="btn-logout">

                                Sair

                            </button>

                        </form>

                    </div>
                }

            </div>

        </nav>

    </header>



    <!-- =====================================================
         CONTEÚDO
    ====================================================== -->

    <main role="main"
          class="chefe-main">

        @RenderBody()

    </main>



    <!-- =====================================================
         RODAPÉ
    ====================================================== -->

    <footer class="chefe-footer">

        <div class="chefe-footer-inner">


            <div class="footer-copyright">

                © @DateTime.Now.Year Chefe IA

            </div>


            <div class="footer-divider"></div>


            <div class="footer-developer">

                Desenvolvido por

                <strong>
                    WLC Sistemas
                </strong>

            </div>


        </div>

    </footer>



    <!-- =====================================================
         SCRIPTS
    ====================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>

</html>